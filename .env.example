# Optional. `python run.py` writes .env itself the first time when no credentials are found (lean CLI login,
# environment). Variables already set in the environment win over this file.
# QuantConnect API credentials of an account with access to the DataFleet admin pages.
QC_USER_ID=
QC_API_TOKEN=
QC_ORGANIZATION_ID=

# Optional alert channels for new findings. The local log reports/alerts.log is always written.
# DSMON_SMTP_HOST=
# DSMON_SMTP_PORT=587
# DSMON_SMTP_USER=
# DSMON_SMTP_PASSWORD=
# DSMON_EMAIL_FROM=
# DSMON_EMAIL_TO=
# DSMON_WEBHOOK_URL=

# Optional: keep the reports folder elsewhere.
# DSMON_REPORTS=
